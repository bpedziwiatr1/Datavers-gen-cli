<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.1"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.5.1"/>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
    </ItemGroup>

    <ItemGroup>
      <!-- Generated-code baselines for ScribanGeneratorTests are data, not test sources -->
      <Compile Remove="Generators\Baselines\**" />
      <None Include="Generators\Baselines\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\DataverseGen.Core\DataverseGen.Core.csproj" />
    </ItemGroup>

</Project>
