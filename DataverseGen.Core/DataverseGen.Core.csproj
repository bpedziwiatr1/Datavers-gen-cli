<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Diagnostics">
            <Version>8.4.2</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client">
            <Version>1.2.27</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client.Dynamics">
            <Version>1.2.27</Version>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json">
            <Version>13.0.4</Version>
        </PackageReference>
        <PackageReference Include="Scriban">
            <Version>7.5.1</Version>
        </PackageReference>
        <!-- Pinned above the vulnerable 8.0.x versions pulled in transitively by Dataverse.Client -->
        <PackageReference Include="System.Security.Cryptography.Pkcs">
            <Version>10.0.13</Version>
        </PackageReference>
        <PackageReference Include="System.Security.Cryptography.Xml">
            <Version>10.0.13</Version>
        </PackageReference>
    </ItemGroup>

</Project>
